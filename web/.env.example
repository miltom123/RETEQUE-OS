# ==============================================================================
# RETEQUEÑOS - VARIABLES DE ENTORNO FRONTEND (Vite + React)
# ==============================================================================

# URL base de la API del catálogo y backend (opcional, fallback local si está vacía)
VITE_API_URL=http://localhost:3000

# Número oficial de WhatsApp de Retequeños Tacna (formato internacional sin signos)
VITE_WHATSAPP_NUMBER=51952000000

# Firebase Auth (Opcional: si están vacías, se utiliza el sistema de autenticación local desacoplado)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Modo de previsualización de smartphone (false en producción para layout responsive real)
VITE_DEVICE_PREVIEW=false
