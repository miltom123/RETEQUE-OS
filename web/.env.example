# ==============================================================================
# RETEQUEÑOS - VARIABLES DE ENTORNO FRONTEND (Vite + React)
# Se leen al compilar (npm run build). Para desarrollo, copiar a .env.local.
# El número de WhatsApp y los datos del negocio están en src/config/site.ts.
# ==============================================================================

# Origen de la API si no está en el mismo dominio (vacío = mismo dominio, /api/...)
VITE_API_URL=

# Simulador de celular y controles de diseño para demos (false en producción)
VITE_DEVICE_PREVIEW=false

# Cuentas de cliente: hoy se guardan solo en el navegador y Google es simulado (false en producción)
VITE_CUSTOMER_ACCOUNTS=false
