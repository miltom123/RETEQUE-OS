# JSON sigue siendo el valor predeterminado. Node no carga .env automáticamente.
RTQ_STORAGE=json
# Horas que un pedido de la web espera la confirmación de caja antes de anularse solo (12 si se omite).
RTQ_PENDING_HOURS=
# URL del proyecto Supabase, sin credenciales; funciona también con Supabase local.
SUPABASE_URL=
# Exclusivamente en el servidor. Nunca usar VITE_ ni enviar esta clave al navegador.
SUPABASE_SECRET_KEY=
# Compatibilidad con la antigua clave JWT service_role, si no se define la anterior.
SUPABASE_SERVICE_ROLE_KEY=
# Contraseñas de las cuentas iniciales. Con PostgreSQL solo se crean si la base no tiene usuarios
# y la contraseña tiene 8 caracteres o más (ver documentacion/PASAR_PRODUCCION_A_SUPABASE.md).
RTQ_ADMIN_PASSWORD=
RTQ_CAJA_PASSWORD=
